recursive-include src/browsertap_mcp/chrome_extension *
exclude src/browsertap_mcp/chrome_extension/config.js
include .gitignore
include README.md
include README.zh-CN.md
include LICENSE
include THIRD-PARTY-NOTICES.md
include SECURITY.md
include CONTRIBUTING.md
include CONTRIBUTING.zh-CN.md
include CHANGELOG.md
include AGENTS.md
recursive-include docs USAGE.md USAGE.zh-CN.md TROUBLESHOOTING.md TROUBLESHOOTING.zh-CN.md
recursive-include examples *.json *.yaml
recursive-include .github/workflows *.yml
include .github/dependabot.yml
exclude SKILL.md
# Kept after the bare `exclude` above so the ordering reads unambiguously: a
# stray `SKILL.md` dropped in the repository root is a caller's own copy and
# stays out, while the two packaged agent skills ship as package data.
recursive-include src/browsertap_mcp/skills SKILL.md
# The sdist carries `scripts/` and `tests/`, so the gates are runnable from it --
# and three of them read `server.json`. Shipping them without it makes
# `versioning check` raise instead of answer.
include server.json
include pyproject.toml
include MANIFEST.in
recursive-include scripts *.py
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
