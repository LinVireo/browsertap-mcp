# Developer identity (local only)
.developer

# Current task pointer (each dev works on different task)
.current-task

# Session/window scoped runtime state
.runtime/

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id

# Live coordination and one-machine task helpers stay local, including archives.
/agent-claims.json
/tasks/**/09-10-zombie-js-after-cdp-timeout/patch_probe.py
/tasks/**/09-10-zombie-js-after-cdp-timeout/patch_race.py
/tasks/**/09-10-zombie-js-after-cdp-timeout/vault_note.py

# Task directory runtime files
.plan-log

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Python cache
**/__pycache__/
**/*.pyc
